# ================================================
# AI 模型配置（对应 Settings: LLM_* / VISION_*）
# ================================================

# 主文本模型（如 DeepSeek）
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# 视觉模型 / 多模态模型（如豆包）
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-1-6-vision-250815
VISION_TEXT_MODEL=doubao-seed-2-0-lite-260215

# ================================================
# PDF 多模态配置
# ================================================
ENABLE_PDF_MULTIMODAL=false

# ================================================
# Milvus 向量数据库配置
# ================================================

# Milvus 连接地址（本地: http://localhost:19530，Zilliz Cloud: https://xxx.zillizcloud.cn）
MILVUS_URL=http://localhost:19530

# 鉴权令牌（本地无鉴权可留空）
MILVUS_TOKEN=

# 数据库名称（使用默认 db 可留空）
MILVUS_DB_NAME=

# mem0 使用的 collection 名称
MILVUS_COLLECTION=edu_agent_memory

# 向量距离度量类型
MILVUS_METRIC_TYPE=COSINE

# RAG 知识库使用的 collection 名称（默认 edu_agent_rag）
# MILVUS_RAG_COLLECTION=edu_agent_rag

# ================================================
# RAG 知识库配置（独立 collection）
# ================================================
# RAG 知识库 collection（默认 edu_agent_rag）
# MILVUS_RAG_COLLECTION=edu_agent_rag

# ----- 分块（可选，有默认值）-----
# RAG_CHUNK_SIZE=800
# RAG_CHUNK_OVERLAP=100
# RAG_CHUNK_MIN=200
# RAG_CHUNK_MAX_LEN=4000

# ----- 检索 -----
# 单次 top_k（默认 5）
# RAG_TOP_K=5

# Hybrid search 每路候选数（默认 20，最终取 max(RAG_HYBRID_FETCH_K, RAG_TOP_K * 2)）
# RAG_HYBRID_FETCH_K=20

# Dense embedding 模型（Ollama 本地拉取）
# 默认使用 qwen3-embedding:0.6b，1024 维
# RAG_DENSE_EMBEDDING_MODEL=qwen3-embedding:0.6b
# RAG_DENSE_EMBEDDING_DIMS=1024

# 说明：Sparse 通路使用 Milvus 内置 BM25 Function + Jieba 中文分词，
# 不依赖任何 Python 侧关键词处理；如需关闭可在 repository 层移除 BM25 Function。

# ================================================
# mem0 配置
# ================================================

# mem0 用于提取记忆事实的 LLM 模型
MEMORY_LLM_MODEL=deepseek-chat

# 嵌入模型提供商（ollama / openai）
MEMORY_EMBEDDER_PROVIDER=ollama

# 嵌入模型名称（如 nomic-embed-text）
MEMORY_EMBEDDING_MODEL=nomic-embed-text

# 嵌入向量维度（如 768）
MEMORY_EMBEDDING_DIMS=768

# Ollama 服务地址
OLLAMA_BASE_URL=http://localhost:11434

# ================================================
# MCP (Model Context Protocol) 工具配置（可选）
# ================================================

# MCP 服务器 JSON 配置，例如：
# MCP_SERVERS_JSON='{"excalidraw":{"transport":"http","url":"https://excalidraw-mcp-app.vercel.app/mcp"}}'
MCP_SERVERS_JSON=

# ================================================
# 日志配置
# ================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
ENABLE_DETAILED_LOGGING=true

# ================================================
# LangGraph 框架配置（不由 Settings 管理，直接由框架读取）
# ================================================
DATABASE_URI=:memory:
REDIS_URI=fake
MIGRATIONS_PATH=__inmem
LANGGRAPH_API_HOST=0.0.0.0
LANGGRAPH_API_PORT=2026
LANGGRAPH_API_URL=http://localhost:2026
ALLOW_PRIVATE_NETWORK=true
LANGGRAPH_UI_BUNDLER=true
LANGGRAPH_RUNTIME_EDITION=inmem
LANGSMITH_LANGGRAPH_API_VARIANT=local_dev
LANGGRAPH_DISABLE_FILE_PERSISTENCE=false
LANGGRAPH_ALLOW_BLOCKING=true
N_JOBS_PER_WORKER=1
