# ================================================
# LLM 主文本模型
# ================================================
LLM_API_KEY=your_llm_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ================================================
# Vision 视觉/多模态模型
# ================================================
VISION_API_KEY=your_vision_api_key_here
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-1-6-vision-250815

# ================================================
# PDF 多模态解析
# ================================================
ENABLE_PDF_MULTIMODAL=true

# ================================================
# Milvus 向量数据库
# 注意：langgraph up 运行在 Docker 容器内时，localhost 需改为 host.docker.internal
# ================================================
MILVUS_URL=http://localhost:19530
MILVUS_TOKEN=
MILVUS_DB_NAME=
MILVUS_METRIC_TYPE=COSINE

# ================================================
# RAG 知识库配置
# ================================================
# Collection 名称
MILVUS_RAG_COLLECTION=edu_agent_rag

# 分块参数
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=100
RAG_CHUNK_MIN=200
RAG_CHUNK_MAX_LEN=4000

# 检索参数
RAG_TOP_K=5
RAG_HYBRID_FETCH_K=20

# ================================================
# mem0 记忆系统配置
# ================================================
# Collection 名称
MEM0_COLLECTION=edu_agent_memory

# ================================================
# 嵌入模型配置（RAG 和 mem0 共用）
# ================================================
# 嵌入模型提供商：ollama 或 openai
EMBEDDING_PROVIDER=

# Ollama 嵌入配置（当 EMBEDDING_PROVIDER=ollama 时使用）
# 注意：langgraph up 运行在 Docker 容器内时，localhost 需改为 host.docker.internal
EMBEDDING_MODEL=
EMBEDDING_DIMS=
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI 兼容接口嵌入配置（当 EMBEDDING_PROVIDER=openai 时使用）
OPENAI_EMBEDDING_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMS=1536

# ================================================
# MCP 工具配置（可选）
# ================================================
MCP_SERVERS_JSON='{
  "mcp-server-chart": {
    "transport": "stdio",
    "command": "npx",
    "args": ["-y", "@antv/mcp-server-chart"]
  }
}'


# ================================================
# 日志配置
# ================================================
LOG_LEVEL=INFO

