# Docker 部署环境变量
# 复制此文件为 edu-agent/.env 并填入实际值

# LLM
LLM_API_KEY=your_llm_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# Vision
VISION_API_KEY=your_vision_api_key
VISION_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
VISION_MODEL=doubao-seed-1-6-vision-250815
VISION_TEXT_MODEL=doubao-seed-2-0-lite-260215

# Milvus（容器内访问宿主机）
MILVUS_URL=http://host.docker.internal:19530

# Ollama（容器内访问宿主机）
OLLAMA_BASE_URL=http://host.docker.internal:11434

# mem0
MEMORY_LLM_MODEL=deepseek-chat
MEMORY_EMBEDDER_PROVIDER=ollama
MEMORY_EMBEDDING_MODEL=nomic-embed-text
MEMORY_EMBEDDING_DIMS=1024

# MCP
MCP_SERVERS_JSON=
